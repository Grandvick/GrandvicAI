# ============================================================================
# GRANDVIC AI — ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to ".env.local" and fill in real values.
# NEVER commit ".env.local" (or any real secrets) to git — it is already
# excluded in .gitignore.
#
# Which values you need right now depends on which phase you are on:
#   - Phase 0 (this foundation): SUPABASE_* values only.
#   - Phase 3+ (AI Core):        OPENAI_API_KEY
#   - Phase 5 (WhatsApp):        WHATSAPP_*
#   - Phase 6 (Automation):      N8N_*
#   - Phase 8 (Social):          META_*, TIKTOK_*, LINKEDIN_*
#   - Phase 9+ (Payments):       PAYMENT provider keys (TBD, see SETUP.md)
#
# The app is designed to run with any of these missing — features that need
# a missing key will show a clear "not configured" message instead of
# crashing. See SETUP.md for step-by-step account creation instructions.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase (database, auth, storage) — required from Phase 0
# Get these from: Supabase Dashboard -> Project -> Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Full database access — bypasses Row Level Security.
# NEVER expose this to the browser. NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# OpenAI (AI Core) — required from Phase 3 onward (AI Command Centre, /ai)
# Get an API key from: https://platform.openai.com/api-keys
# All calls happen server-side only — this key is never sent to the browser.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Local development/testing switch (Phase 4). Set to "mock" to use a
# deterministic, zero-cost, rule-based provider instead of the real OpenAI
# API — lets you develop and test the AI Command Centre AND the AI Sales
# Agent (test) simulator without live OpenAI billing/credits. It still runs
# the real tool-calling loop and real Phase 4 business logic (intent
# detection, job matching, qualification, lead creation/scoring,
# conversation events, human takeover) — it just never calls OpenAI.
#   AI_PROVIDER=mock
# Leave blank (or "openai") for the real provider — this is what production
# must use. See SETUP.md section 3b and src/lib/ai/provider/dev-mock.ts.
AI_PROVIDER=
# Which OpenAI model the AI Command Centre uses. Leave blank to default to
# gpt-4o-mini (cheap, fast, good enough for tool-calling business lookups).
OPENAI_MODEL=
# Legacy/alternate names for the same setting, still honored as fallbacks —
# see aiModelConfig in src/lib/config.ts. Prefer OPENAI_MODEL above.
AI_MODEL_DEFAULT=
AI_MODEL_FAST=
AI_MODEL_ADVANCED=
# Basic abuse protection (spec section 16) — max AI Command Centre requests
# per signed-in user per minute. Leave blank to default to 10.
AI_RATE_LIMIT_PER_MINUTE=

# ---------------------------------------------------------------------------
# WhatsApp Business Platform (Cloud API) — required from Phase 5
# Get from: https://developers.facebook.com/apps (WhatsApp product)
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Graph API version (Phase 5G) — e.g. "v21.0". No default is hard-coded here
# on purpose: Meta deprecates versions on a schedule, so verify the current
# version against Meta's developer docs rather than trusting a stale example.
# Required for real sending (WHATSAPP_PROVIDER unset or anything but "mock");
# irrelevant when WHATSAPP_PROVIDER=mock.
WHATSAPP_API_VERSION=
# Local development/testing switch (Phase 5B), mirroring AI_PROVIDER above.
# Set to "mock" to use MockWhatsAppProvider — a zero-network, deterministic
# stand-in that logs sends instead of calling Meta — so the channel
# orchestration layer can be built and tested without any Meta credentials
# at all. Anything other than "mock" (including unset) selects the real,
# Graph API-backed MetaWhatsAppProvider (Phase 5G) — which then requires
# WHATSAPP_ACCESS_TOKEN/WHATSAPP_PHONE_NUMBER_ID/WHATSAPP_API_VERSION to
# actually be set, or the factory throws a clear WhatsAppConfigError rather
# than guess. See src/lib/channels/whatsapp/provider/index.ts.
#   WHATSAPP_PROVIDER=mock
WHATSAPP_PROVIDER=

# ---------------------------------------------------------------------------
# n8n (automation/orchestration) — required from Phase 6
# ---------------------------------------------------------------------------
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_API_KEY=

# ---------------------------------------------------------------------------
# Meta (Facebook + Instagram publishing) — required from Phase 8
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# TikTok (publishing) — required from Phase 8, if enabled
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# LinkedIn (publishing) — required from Phase 8, if enabled
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email (owner notifications) — optional, from Phase 6/10
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Payments — provider TBD. Do not hard-code a provider into core logic.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# App-level
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
